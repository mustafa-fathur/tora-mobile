# Copy to .env.local and fill in. Same values as the web app's NEXT_PUBLIC_* ones.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Address of the Tora web app, no trailing slash (used for "Forgot password" and "Open Tora on the web").
EXPO_PUBLIC_WEB_URL=https://your-tora-web-domain
# NEVER put the service_role / secret key or the database password in the app.
